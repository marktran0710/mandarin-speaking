OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# Signs/verifies login JWTs (backend/auth.py). Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder in a real deployment.
JWT_SECRET_KEY=change-me-generate-a-real-secret

# Admin console login (routers/admin.py). Required - the console refuses
# login with 503 if this is unset. Pick a real password in production.
ADMIN_PASSWORD=change-me

# Local PostgreSQL (docker compose up -d db). Host port is 5433, not the
# Postgres default 5432 - see docker-compose.yml. Override here if your
# container maps yet another port.
DATABASE_URL=postgresql://mandarin:mandarin@127.0.0.1:5433/mandarin
UPLOAD_DIR=./uploads
MAX_AUDIO_BYTES=10485760
