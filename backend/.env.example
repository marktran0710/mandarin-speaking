OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# Signs/verifies login JWTs (backend/auth.py). Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder in a real deployment.
JWT_SECRET_KEY=change-me-generate-a-real-secret

# Set only for the public production deployment. Production requires HTTPS,
# a persistent /data volume, and an explicitly configured admin password.
APP_ENV=development
COOKIE_SECURE=false

# Admin console login (routers/admin.py). Required - the console refuses
# login with 503 if this is unset. Pick a real password in production.
ADMIN_PASSWORD=change-me

# Local PostgreSQL (docker compose -f docker-compose.dev.yml up -d db). Host
# port is 5433, not the Postgres default 5432 - see docker-compose.dev.yml.
# Override here if your container maps yet another port.
DATABASE_URL=postgresql://mandarin:mandarin@127.0.0.1:5433/mandarin
UPLOAD_DIR=./uploads
MAX_AUDIO_BYTES=10485760
# Students may use the pronunciation evaluator by default. Set false to
# temporarily restrict that endpoint to teachers/admins again.
PRONUNCIATION_SCORE_STUDENT_VISIBLE=true

# Send this recording and its server-resolved script to OMPAL for a separate
# comparison. Does not affect local grades/mastery. Disable to keep audio local.
PRONUNCIATION_OMPAL_ENABLED=true
PRONUNCIATION_OMPAL_TIMEOUT_SECONDS=30
# Wav2Vec2 segmental pronunciation stage. The dev Docker image installs the
# local-ASR extras; point MODEL at a cached Hugging Face model or allow the
# configured model loader to resolve it. Results remain unavailable if this
# stage is disabled or its model cannot load.
PRONUNCIATION_WAV2VEC2_ENABLED=true
PRONUNCIATION_WAV2VEC2_MODEL=TencentGameMate/chinese-wav2vec2-base
PRONUNCIATION_WAV2VEC2_LAYER=6
# PRONUNCIATION_WAV2VEC2_CACHE_DIR=./data/wav2vec2-cache
# Optional teacher/student comparison using librosa MFCC + DTW and pYIN F0.
# The local-ASR extras install librosa for development; a deployment without
# it returns an unavailable comparison while Praat/Wav2Vec2 continue normally.
PRONUNCIATION_LIBROSA_COMPARISON_ENABLED=true
# Optional calibration knobs for the evidence adapter; defaults are documented
# in services/pronunciation/librosa_comparison.py and do not set rubric scores.
# PRONUNCIATION_LIBROSA_SILENCE_TOP_DB=35
# PRONUNCIATION_LIBROSA_VOICED_PROBABILITY_MINIMUM=0.35
# PRONUNCIATION_LIBROSA_MFCC_DISTANCE_SCALE=5
# PRONUNCIATION_LIBROSA_PITCH_DISTANCE_SCALE_SEMITONES=4
# PRONUNCIATION_LIBROSA_FMIN_HZ=65
# PRONUNCIATION_LIBROSA_FMAX_HZ=500
# Resource limits: duration beyond the limit makes comparison unavailable;
# longer MFCC sequences are downsampled before DTW to bound its matrix.
# PRONUNCIATION_LIBROSA_MAX_DURATION_SECONDS=60
# PRONUNCIATION_LIBROSA_MAX_DTW_FRAMES=2000
# PRONUNCIATION_RUBRIC_POLICY_JSON={}
# Exact remote hosts allowed for server-side image/audio import. Leave empty
# unless the deployment explicitly needs third-party media fetching.
REMOTE_MEDIA_ALLOWED_HOSTS=oaidalleapiprodscus.blob.core.windows.net,pollinations.ai,image.pollinations.ai

# Caps concurrent /api/analyze CPU-bound work (Praat, local ASR) - see
# main.analyze_semaphore. Tune to roughly the Lab machine's CPU core count;
# extra requests queue instead of thrashing every core at once.
ANALYZE_CONCURRENCY_LIMIT=4
# Maximum admitted analysis/transcription requests (active + waiting). Extra
# requests receive 503 with Retry-After instead of exhausting memory/CPU.
ANALYZE_QUEUE_LIMIT=16

# Retry attempts for calls to external AI provider APIs (OpenAI/Groq/Gemini)
# on timeouts/network errors and 429/5xx responses - see main._post_with_retry.
ASR_PROVIDER_MAX_ATTEMPTS=3

# Postgres connection pool sizing - see database.py's comment above these
# defaults for why 20/2 is sized the way it is.
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_SECONDS=10
