OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# Local PostgreSQL (docker compose up -d db). Host port is 5433, not the
# Postgres default 5432 - see docker-compose.yml. Override here if your
# container maps yet another port.
DATABASE_URL=postgresql://mandarin:mandarin@127.0.0.1:5433/mandarin
UPLOAD_DIR=./uploads
MAX_AUDIO_BYTES=10485760
