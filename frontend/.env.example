# Leave blank for local Docker so the browser uses its own origin and Vite
# proxies /api and /uploads to the backend container.
VITE_BACKEND_URL=

# Next.js server-side proxy target. Keep this server-only in deployments.
BACKEND_INTERNAL_URL=

# Optional browser-visible backend origin for direct client calls during migration.
NEXT_PUBLIC_BACKEND_URL=

# Practice and conversation show separate 1-5 rubric scores by default.
# Set false to temporarily hide those scores while keeping charts/feedback.
VITE_SHOW_VOICE_RUBRIC_SCORES=true
