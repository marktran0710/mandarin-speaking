{
  "name": "enjoyable-mandarin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:next": "next dev",
    "build": "tsc -p tsconfig.app.json && vite build",
    "build:next": "next build",
    "start:next": "next start",
    "typecheck:all": "tsc --noEmit --noUnusedLocals false --noUnusedParameters false",
    "check:lines": "node scripts/check-lines.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run src/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "next": "^16.3.2",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
